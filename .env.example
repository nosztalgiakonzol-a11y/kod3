# Example Environment Variables for Surebet Bot
# Copy this file to .env and fill in your values

# Surebet.com credentials
SUREBET_USERNAME=your_username_here
SUREBET_PASSWORD=your_password_here

# Bot settings
MAX_GROUP_TABS=5
MAX_NEXT_TABS=3
JSON_UPDATE_INTERVAL=10

# Chrome settings
CHROME_HEADLESS=true
CHROME_NO_SANDBOX=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=surebet_bot.log
